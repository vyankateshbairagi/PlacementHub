# ==============================================================================
# PlacementHub - Assessment Microservice Environment Variables
# Location: assessment_service/.env
# ==============================================================================

# Port the service listens on:
PORT=5001

# Environment Mode: "development" or "production"
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# NOTE: Must point to the SAME database as career_os so assessments & users stay synced!
# ------------------------------------------------------------------------------
# Direct connection string for Prisma migrations:
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>/<DB_NAME>?sslmode=require"

# Pooled connection string for queries:
DATABASE_URL_POOLED="postgresql://<USER>:<PASSWORD>@<HOST_POOLER>/<DB_NAME>?sslmode=require"

# Allowed web origins for CORS (comma separated):
CORS_ORIGIN="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"
