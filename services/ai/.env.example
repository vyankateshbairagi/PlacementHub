# ==============================================================================
# PlacementHub - AI Microservice (FastAPI + Ollama / PostgreSQL)
# Location: placementhub-ai/.env
# ==============================================================================

# LLM Model used by Ollama:
AI_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection (AsyncPG format)
# IMPORTANT: SQLAlchemy Async requires "postgresql+asyncpg://" prefix instead of "postgresql://"
# If your Neon URL is:
#   postgresql://user:pass@ep-xyz.aws.neon.tech/neondb?sslmode=require
# Then set DATABASE_URL as:
#   postgresql+asyncpg://user:pass@ep-xyz.aws.neon.tech/neondb?ssl=require
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>/<DB_NAME>?ssl=require
